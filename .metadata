# This file tracks properties of this Flutter project.
# Used by Flutter tool to assess capabilities and perform upgrades etc.
#
# This file should be version controlled and should not be manually edited.

version:
  revision: "0000000000000000000000000000000000000000"
  channel: "stable"

project_type: app

# Tracks the migration of platform-specific tooling. Only Linux is enabled
# because horaloca is a Linux-desktop-only utility.
migration:
  platforms:
    - platform: root
      create_revision: "0000000000000000000000000000000000000000"
      base_revision: "0000000000000000000000000000000000000000"
    - platform: linux
      create_revision: "0000000000000000000000000000000000000000"
      base_revision: "0000000000000000000000000000000000000000"

  unmanaged_files:
    - "lib/main.dart"
    - "ios/Runner.xcodeproj/project.pbxproj"
